FROM golang:1.24-bookworm AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY cmd ./cmd
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /trinity-api ./cmd/api

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /trinity-api /trinity-api
EXPOSE 8080
ENTRYPOINT ["/trinity-api"]
